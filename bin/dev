#!/bin/bash

DEV_FLOW_DIR="$HOME/proyectos/dev-flow-"

case "$1" in

    doctor)
        "$DEV_FLOW_DIR/scripts/doctor.sh"
        ;;

    ports)
        "$DEV_FLOW_DIR/scripts/check-ports.sh"
        ;;

    check)
        "$DEV_FLOW_DIR/scripts/check.sh"
        ;;

    detect)
        "$DEV_FLOW_DIR/scripts/detect-project.sh"
        ;;

    error)
        "$DEV_FLOW_DIR/scripts/find-error.sh" "$2"
        ;;

    *)
        echo "DEV-FLOW"
        echo ""
        echo "Uso:"
        echo "  dev doctor    Diagnostica el entorno"
        echo "  dev ports     Revisa los puertos"
        echo "  dev check     Revisa el proyecto actual"
        echo "  dev detect    Detecta el tipo de proyecto"
        echo "  dev error     Busca errores en la base de conocimiento"
        echo ""
        ;;

esac
